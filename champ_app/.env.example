# Copiez ce fichier en .env (non versionné) puis adaptez-le.

# Développement local : autorise un secret JWT de développement public.
ENV=development

# Production : retirez la ligne ENV=development et définissez un secret fort, par ex.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=

# Optionnel : CSP en mode « signalement seulement » (ne bloque rien) pour la tester sur de vrais appareils.
# CSP_REPORT_ONLY=1
# Optionnel : limites (valeurs par défaut indiquées)
# ANALYSIS_RATE_LIMIT=60/hour
# MAX_BODY_BYTES=1000000
